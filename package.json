{
  "name": "goshootfilm",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:mobile": "vite --config vite.mobile.config.ts --host",
    "build:mobile": "vue-tsc --noEmit -p tsconfig.mobile.json && vite build --config vite.mobile.config.ts",
    "preview:mobile": "vite preview --config vite.mobile.config.ts --host",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File android/tools/build-release.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
