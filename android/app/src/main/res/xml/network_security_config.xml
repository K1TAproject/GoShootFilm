<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app only talks to the desktop sync server on the local network.
         OkHttp additionally rejects non-private hosts in ApiClient. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
